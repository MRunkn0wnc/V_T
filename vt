    "analysis": "Fetch the status/result of an analysis by its ID (printed by upload/url/rescan).\n\n"
                "Examples:\n  vt analysis <analysis_id>\n",
    "comments": "Show community comments for a hash, domain, IP or URL.\n\n"
                "Examples:\n  vt comments <sha256>\n  vt comments example.com --limit 20\n"
                "  vt comments 8.8.8.8\n",
    "bulk": "Look up many hashes from a text file (one per line, '#' lines ignored).\n\n"
            "Examples:\n  vt bulk hashes.txt\n"
            "  vt bulk hashes.txt --csv results.csv\n"
            "  vt bulk hashes.txt --delay 0       # premium keys only\n\n"
            "Default delay is 15s per request to respect the free tier (4 req/min).\n",
    "quota": "Show API quota usage for the current key.\n\n"
             "Examples:\n  vt quota\n  vt quota -k YOUR_KEY\n",
}

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-k", "--api-key", help="VirusTotal API key (overrides env/config)")
    common.add_argument("--json", action="store_true", help="Output raw JSON")

    p = argparse.ArgumentParser(
        prog="vt",
        description="VirusTotal CLI (API v3) - look up files, URLs, domains and IPs, "
                    "and submit files/URLs for scanning.",
        epilog=MAIN_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="command", required=True, metavar="COMMAND")

    s = sub.add_parser("config", help="Manage the saved API key")
    s.add_argument("action", choices=["set-key", "show", "clear"])
    s.add_argument("value", nargs="?", help="API key (for set-key)")

    s = sub.add_parser("hash", parents=[common], help="Look up a file by MD5/SHA1/SHA256")
    s.add_argument("hash")

    s = sub.add_parser("check", parents=[common], help="Hash a local file and look it up (no upload)")
    s.add_argument("file")

    s = sub.add_parser("upload", parents=[common], help="Upload a file for scanning")
    s.add_argument("file")
    s.add_argument("--wait", action="store_true", help="Wait for analysis to finish")
    s.add_argument("--timeout", type=int, default=600)
    s.add_argument("-y", "--yes", action="store_true", help="Skip upload confirmation")

    s = sub.add_parser("rescan", parents=[common], help="Request re-analysis of a known file")
    s.add_argument("hash")
    s.add_argument("--wait", action="store_true")
    s.add_argument("--timeout", type=int, default=600)

    s = sub.add_parser("url", parents=[common], help="Report on a URL (submits if unknown)")
    s.add_argument("url")
    s.add_argument("--submit", action="store_true", help="Force a fresh scan")
    s.add_argument("--wait", action="store_true")
    s.add_argument("--timeout", type=int, default=600)

    s = sub.add_parser("domain", parents=[common], help="Domain report")
    s.add_argument("domain")

    s = sub.add_parser("ip", parents=[common], help="IP address report")
    s.add_argument("ip")

    s = sub.add_parser("analysis", parents=[common], help="Fetch an analysis by ID")
    s.add_argument("id")

    s = sub.add_parser("comments", parents=[common], help="Community comments for a hash/domain/IP/URL")
    s.add_argument("target")
    s.add_argument("--limit", type=int, default=10)

    s = sub.add_parser("bulk", parents=[common], help="Look up many hashes from a file")
    s.add_argument("file", help="Text file, one hash per line")
    s.add_argument("--csv", help="Write results to CSV")
    s.add_argument("--delay", type=float, default=15.0,
                   help="Seconds between requests (default 15 = free-tier friendly; 0 to disable)")

    sub.add_parser("quota", parents=[common], help="Show API quota usage")

    # Detailed per-command help ("vt <command> --help")
    for name, text in COMMAND_HELP.items():
        sp = sub.choices[name]
        sp.description = text.split("\n\n")[0]
        sp.epilog = text
        sp.formatter_class = argparse.RawDescriptionHelpFormatter
    return p


def main():
    args = build_parser().parse_args()
    if args.command == "config":
        if args.action == "set-key" and not args.value:
            die("Usage: vt config set-key <API_KEY>")
        return cmd_config(args)
    vt = VT(resolve_key(args.api_key))
    handlers = {
        "hash": cmd_hash, "check": cmd_check, "upload": cmd_upload,
        "rescan": cmd_rescan, "url": cmd_url, "domain": cmd_domain,
        "ip": cmd_ip, "analysis": cmd_analysis, "comments": cmd_comments,
        "bulk": cmd_bulk, "quota": cmd_quota,
    }
    try:
        handlers[args.command](args, vt)
    except KeyboardInterrupt:
        die("Interrupted.", 130)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
