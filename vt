#!/usr/bin/env python3
"""
vt - A lightweight VirusTotal CLI (API v3). Stdlib only, no dependencies.

API key resolution order (first match wins):
  1. --api-key KEY
  2. VT_API_KEY environment variable
  3. Saved config file (~/.config/vt-cli/config.json) via:  vt config set-key KEY

Examples:
  vt config set-key YOUR_KEY
  vt hash 44d88612fea8a8f36de82e1278abb02f
  vt check ./suspicious.exe            # hashes locally, looks up, no upload
  vt upload ./suspicious.exe --wait    # upload + wait for analysis
  vt rescan <sha256> --wait
  vt url https://example.com --wait
  vt domain example.com
  vt ip 8.8.8.8
  vt analysis <analysis_id>
  vt comments <hash|domain|ip>
  vt bulk hashes.txt --csv out.csv     # one hash per line
  vt quota
  vt domain example.com --json         # raw JSON for any command

Use only for legitimate security work. Mind VirusTotal's terms and
public-API limits (free tier: 4 requests/min, 500/day). Files you upload
become accessible to VT's community - never upload sensitive documents.
"""

