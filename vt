BASE = "https://www.virustotal.com/api/v3"
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "vt-cli" / "config.json"
SMALL_UPLOAD_LIMIT = 32 * 1024 * 1024  # 32 MB
MAX_UPLOAD = 650 * 1024 * 1024         # 650 MB

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else str(text)


red = lambda t: c(t, "31")
green = lambda t: c(t, "32")
yellow = lambda t: c(t, "33")
cyan = lambda t: c(t, "36")
bold = lambda t: c(t, "1")
dim = lambda t: c(t, "2")


# --------------------------------------------------------------------------
# Config / API key
# --------------------------------------------------------------------------
def load_config():
    try:
        return json.loads(CONFIG_PATH.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2))
    try:
        os.chmod(CONFIG_PATH, 0o600)
    except OSError:
        pass


def resolve_key(cli_key):
    key = cli_key or os.environ.get("VT_API_KEY") or load_config().get("api_key")
    if not key:
        die("No API key. Use --api-key, set VT_API_KEY, or run: vt config set-key <KEY>")
    return key.strip()


def die(msg, code=1):
    print(red(f"[!] {msg}"), file=sys.stderr)
    sys.exit(code)


# --------------------------------------------------------------------------
# HTTP client
# --------------------------------------------------------------------------
class VT:
    def __init__(self, key, retries=3):
        self.key = key
        self.retries = retries

    def _request(self, method, url, data=None, headers=None):
        hdrs = {"x-apikey": self.key, "accept": "application/json",
                "User-Agent": "vt-cli/1.0"}
        hdrs.update(headers or {})
        if not url.startswith("http"):
            url = BASE + url
        for attempt in range(self.retries + 1):
            req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    body = resp.read()
                    return json.loads(body) if body else {}
            except urllib.error.HTTPError as e:
                body = e.read().decode("utf-8", "replace")
                try:
                    err = json.loads(body).get("error", {})
                except json.JSONDecodeError:
                    err = {}
                if e.code == 429 and attempt < self.retries:
                    wait = 20 * (attempt + 1)
                    print(yellow(f"[~] Rate limited. Waiting {wait}s..."), file=sys.stderr)
                    time.sleep(wait)
                    continue
                if e.code == 401:
                    die("Authentication failed: invalid API key.")
                if e.code == 404:
                    return {"error": {"code": "NotFoundError", "message": "Not found in VirusTotal."}}
                die(f"HTTP {e.code}: {err.get('code', '')} {err.get('message', body[:200])}")
            except urllib.error.URLError as e:
                die(f"Network error: {e.reason}")

    def get(self, path):
        return self._request("GET", path)

    def post_form(self, path, fields):
        data = urllib.parse.urlencode(fields).encode()
        return self._request("POST", path, data=data,
                             headers={"Content-Type": "application/x-www-form-urlencoded"})

    def post_file(self, url, filepath):
        boundary = uuid.uuid4().hex
        name = os.path.basename(filepath)
        ctype = mimetypes.guess_type(name)[0] or "application/octet-stream"
        with open(filepath, "rb") as f:
            content = f.read()
        head = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; "
                f"filename=\"{name}\"\r\nContent-Type: {ctype}\r\n\r\n").encode()
        tail = f"\r\n--{boundary}--\r\n".encode()
        return self._request("POST", url, data=head + content + tail,
                             headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})

    def post(self, path):
        return self._request("POST", path, data=b"")


# --------------------------------------------------------------------------
# Helpers
# --------------------------------------------------------------------------
def fmt_ts(ts):
    if not ts:
        return "n/a"
    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")


def hash_file(path):
    h = {"md5": hashlib.md5(), "sha1": hashlib.sha1(), "sha256": hashlib.sha256()}
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            for x in h.values():
                x.update(chunk)
    return {k: v.hexdigest() for k, v in h.items()}


def url_id(url):
    return base64.urlsafe_b64encode(url.encode()).decode().strip("=")


def is_hash(s):
    return bool(re.fullmatch(r"[a-fA-F0-9]{32}|[a-fA-F0-9]{40}|[a-fA-F0-9]{64}", s))


def verdict_line(stats):
    mal = stats.get("malicious", 0)
    sus = stats.get("suspicious", 0)
    total = sum(v for k, v in stats.items() if k in
                ("malicious", "suspicious", "harmless", "undetected", "timeout"))
    text = f"{mal + sus}/{total} flagged  (malicious: {mal}, suspicious: {sus}, " \
           f"harmless: {stats.get('harmless', 0)}, undetected: {stats.get('undetected', 0)})"
    if mal > 0:
        return red(text)
    if sus > 0:
        return yellow(text)
    return green(text)


def kv(label, value):
    print(f"  {cyan(label + ':'):<28} {value}")


def print_detections(results, limit=25):
    flagged = [(eng, r) for eng, r in results.items()
               if r.get("category") in ("malicious", "suspicious")]
    if not flagged:
        return
    print(bold("\n  Detections"))
    for eng, r in sorted(flagged)[:limit]:
        col = red if r["category"] == "malicious" else yellow
        print(f"    {col(eng):<30} {r.get('result') or r['category']}")
    if len(flagged) > limit:
        print(dim(f"    ... and {len(flagged) - limit} more (use --json for all)"))


def not_found(resp):
    return isinstance(resp, dict) and resp.get("error", {}).get("code") == "NotFoundError"


def emit(args, resp, printer):
    if args.json:
        print(json.dumps(resp, indent=2))
    elif not_found(resp):
        print(yellow("[?] Not found in VirusTotal (never seen). Try 'upload' / 'url' to submit."))
    else:
        printer(resp)


# --------------------------------------------------------------------------
# Printers
# --------------------------------------------------------------------------
def print_file(resp):
    a = resp["data"]["attributes"]
    print(bold(f"\n  FILE REPORT  {a.get('sha256', '')}"))
    kv("Verdict", verdict_line(a.get("last_analysis_stats", {})))
    kv("Name", a.get("meaningful_name") or (a.get("names") or ["n/a"])[0])
    kv("Type", a.get("type_description", "n/a"))
    kv("Size", f"{a.get('size', 0):,} bytes")
    kv("MD5", a.get("md5", ""))
    kv("SHA1", a.get("sha1", ""))
    kv("SHA256", a.get("sha256", ""))
    ptc = a.get("popular_threat_classification", {})
    if ptc.get("suggested_threat_label"):
        kv("Threat label", red(ptc["suggested_threat_label"]))
    kv("Reputation", a.get("reputation", 0))
    kv("First submitted", fmt_ts(a.get("first_submission_date")))
    kv("Last analysed", fmt_ts(a.get("last_analysis_date")))
    kv("Times submitted", a.get("times_submitted", "n/a"))
    tags = a.get("tags")
    if tags:
        kv("Tags", ", ".join(tags))
    print_detections(a.get("last_analysis_results", {}))
    print(dim(f"\n  https://www.virustotal.com/gui/file/{a.get('sha256', '')}"))


def print_url(resp):
    a = resp["data"]["attributes"]
    print(bold(f"\n  URL REPORT  {a.get('url', '')}"))
    kv("Verdict", verdict_line(a.get("last_analysis_stats", {})))
    kv("Final URL", a.get("last_final_url", "n/a"))
    kv("Title", a.get("title", "n/a"))
    kv("Reputation", a.get("reputation", 0))
    kv("Last analysed", fmt_ts(a.get("last_analysis_date")))
    cats = a.get("categories")
    if cats:
        kv("Categories", ", ".join(sorted(set(cats.values()))))
    print_detections(a.get("last_analysis_results", {}))
    print(dim(f"\n  https://www.virustotal.com/gui/url/{resp['data']['id']}"))


def print_domain(resp):
    a = resp["data"]["attributes"]
    print(bold(f"\n  DOMAIN REPORT  {resp['data']['id']}"))
    kv("Verdict", verdict_line(a.get("last_analysis_stats", {})))
    kv("Registrar", a.get("registrar", "n/a"))
    kv("Created", fmt_ts(a.get("creation_date")))
    kv("Reputation", a.get("reputation", 0))
    kv("TLD", a.get("tld", "n/a"))
    cats = a.get("categories")
    if cats:
        kv("Categories", ", ".join(sorted(set(cats.values()))))
    dns = a.get("last_dns_records", [])
    if dns:
        print(bold("\n  DNS records"))
        for r in dns[:15]:
            print(f"    {r.get('type', ''):<6} {r.get('value', '')}")
    print_detections(a.get("last_analysis_results", {}))
    print(dim(f"\n  https://www.virustotal.com/gui/domain/{resp['data']['id']}"))


def print_ip(resp):
    a = resp["data"]["attributes"]
    print(bold(f"\n  IP REPORT  {resp['data']['id']}"))
    kv("Verdict", verdict_line(a.get("last_analysis_stats", {})))
    kv("Country", a.get("country", "n/a"))
    kv("AS owner", a.get("as_owner", "n/a"))
    kv("ASN", a.get("asn", "n/a"))
    kv("Network", a.get("network", "n/a"))
    kv("Reputation", a.get("reputation", 0))
    print_detections(a.get("last_analysis_results", {}))
    print(dim(f"\n  https://www.virustotal.com/gui/ip-address/{resp['data']['id']}"))


def print_analysis(resp):
    a = resp["data"]["attributes"]
    status = a.get("status")
    print(bold(f"\n  ANALYSIS  {resp['data']['id']}"))
    kv("Status", green(status) if status == "completed" else yellow(status))
    kv("Verdict", verdict_line(a.get("stats", {})))
    kv("Date", fmt_ts(a.get("date")))
    print_detections(a.get("results", {}))
    sha = resp.get("meta", {}).get("file_info", {}).get("sha256")
    if sha:
        print(dim(f"\n  https://www.virustotal.com/gui/file/{sha}"))


def print_comments(resp):
    items = resp.get("data", [])
    if not items:
        print("  No comments.")
        return
    for it in items:
        a = it["attributes"]
        print(f"\n  {cyan(fmt_ts(a.get('date')))}  votes: +{a.get('votes', {}).get('positive', 0)}"
              f"/-{a.get('votes', {}).get('negative', 0)}")
        print("  " + a.get("text", "").replace("\n", "\n  "))


# --------------------------------------------------------------------------
# Analysis polling
# --------------------------------------------------------------------------
def wait_for_analysis(vt, analysis_id, timeout=600, interval=15):
    start = time.time()
    while True:
        resp = vt.get(f"/analyses/{analysis_id}")
        status = resp.get("data", {}).get("attributes", {}).get("status")
        if status == "completed":
            return resp
        if time.time() - start > timeout:
            die(f"Timed out waiting for analysis {analysis_id}")
        print(dim(f"  ... status: {status}, checking again in {interval}s"), file=sys.stderr)
        time.sleep(interval)


def finish_submission(args, vt, resp, kind):
    aid = resp.get("data", {}).get("id")
    if not aid:
        die("Submission failed: no analysis ID returned.")
    if not args.wait:
        if args.json:
            print(json.dumps(resp, indent=2))
        else:
            print(green(f"[+] {kind} submitted. Analysis ID:"))
            print(f"    {aid}")
            print(dim(f"    Check later: vt analysis {aid}"))
        return
    print(dim("[*] Waiting for analysis to complete..."), file=sys.stderr)
    final = wait_for_analysis(vt, aid, timeout=args.timeout)
    emit(args, final, print_analysis)


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
def cmd_config(args):
    cfg = load_config()
    if args.action == "set-key":
        cfg["api_key"] = args.value.strip()
        save_config(cfg)
        print(green(f"[+] API key saved to {CONFIG_PATH}"))
    elif args.action == "show":
        k = cfg.get("api_key")
        print(f"Config file: {CONFIG_PATH}")
        print("Saved key:  ", (k[:4] + "..." + k[-4:]) if k else "(none)")
        print("VT_API_KEY: ", "set" if os.environ.get("VT_API_KEY") else "(not set)")
    elif args.action == "clear":
        cfg.pop("api_key", None)
        save_config(cfg)
        print(green("[+] Saved API key removed."))


def cmd_hash(args, vt):
    if not is_hash(args.hash):
        die("Not a valid MD5/SHA1/SHA256 hash.")
    emit(args, vt.get(f"/files/{args.hash}"), print_file)


def cmd_check(args, vt):
    p = Path(args.file)
    if not p.is_file():
        die(f"No such file: {p}")
    hashes = hash_file(p)
    if not args.json:
        print(dim(f"[*] SHA256: {hashes['sha256']}  (file not uploaded)"))
    emit(args, vt.get(f"/files/{hashes['sha256']}"), print_file)


def cmd_upload(args, vt):
    p = Path(args.file)
    if not p.is_file():
        die(f"No such file: {p}")
    size = p.stat().st_size
    if size > MAX_UPLOAD:
        die("File exceeds the 650 MB VirusTotal limit.")
    if not args.yes:
        ans = input(yellow(f"Upload '{p.name}' to VirusTotal? It becomes visible to the community. [y/N] "))
        if ans.lower() != "y":
            die("Aborted.", 0)
    if size > SMALL_UPLOAD_LIMIT:
        upload_url = vt.get("/files/upload_url")["data"]
        resp = vt.post_file(upload_url, str(p))
    else:
        resp = vt.post_file("/files", str(p))
    finish_submission(args, vt, resp, "File")


def cmd_rescan(args, vt):
    if not is_hash(args.hash):
        die("Not a valid hash.")
    resp = vt.post(f"/files/{args.hash}/analyse")
    finish_submission(args, vt, resp, "Rescan")


def cmd_url(args, vt):
    if args.submit:
        resp = vt.post_form("/urls", {"url": args.url})
        finish_submission(args, vt, resp, "URL")
        return
    resp = vt.get(f"/urls/{url_id(args.url)}")
    if not_found(resp) and not args.json:
        print(yellow("[?] URL not yet known to VT - submitting for analysis..."))
        resp = vt.post_form("/urls", {"url": args.url})
        finish_submission(args, vt, resp, "URL")
        return
    emit(args, resp, print_url)


def cmd_domain(args, vt):
    emit(args, vt.get(f"/domains/{args.domain}"), print_domain)


def cmd_ip(args, vt):
    emit(args, vt.get(f"/ip_addresses/{args.ip}"), print_ip)


def cmd_analysis(args, vt):
    emit(args, vt.get(f"/analyses/{args.id}"), print_analysis)


def cmd_comments(args, vt):
    t = args.target
    if is_hash(t):
        path = f"/files/{t}/comments"
    elif re.fullmatch(r"\d{1,3}(\.\d{1,3}){3}", t) or ":" in t:
        path = f"/ip_addresses/{t}/comments"
    elif t.startswith("http"):
        path = f"/urls/{url_id(t)}/comments"
    else:
        path = f"/domains/{t}/comments"
    emit(args, vt.get(path + f"?limit={args.limit}"), print_comments)


def cmd_bulk(args, vt):
    lines = [l.strip() for l in Path(args.file).read_text().splitlines()
             if l.strip() and not l.startswith("#")]
    rows = []
    for i, h in enumerate(lines, 1):
        if not is_hash(h):
            print(yellow(f"[!] Skipping invalid hash: {h}"), file=sys.stderr)
            continue
        resp = vt.get(f"/files/{h}")
        if not_found(resp):
            rows.append({"hash": h, "status": "not_found"})
            print(f"  [{i}/{len(lines)}] {h}  {yellow('not found')}")
        else:
            a = resp["data"]["attributes"]
            s = a.get("last_analysis_stats", {})
            rows.append({
                "hash": h, "status": "found",
                "malicious": s.get("malicious", 0), "suspicious": s.get("suspicious", 0),
                "harmless": s.get("harmless", 0), "undetected": s.get("undetected", 0),
                "name": a.get("meaningful_name", ""), "type": a.get("type_description", ""),
                "label": a.get("popular_threat_classification", {}).get("suggested_threat_label", ""),
                "sha256": a.get("sha256", ""),
            })
            col = red if s.get("malicious", 0) else green
            print(f"  [{i}/{len(lines)}] {h}  {col(str(s.get('malicious', 0)) + ' malicious')}")
        if i < len(lines) and args.delay:
            time.sleep(args.delay)
    if args.csv:
        fields = ["hash", "status", "malicious", "suspicious", "harmless",
                  "undetected", "name", "type", "label", "sha256"]
        with open(args.csv, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=fields)
            w.writeheader()
            w.writerows(rows)
        print(green(f"[+] Results written to {args.csv}"))
    if args.json:
        print(json.dumps(rows, indent=2))


def cmd_quota(args, vt):
    resp = vt.get(f"/users/{vt.key}")
    if args.json:
        print(json.dumps(resp, indent=2))
        return
    a = resp["data"]["attributes"]
    print(bold(f"\n  ACCOUNT  {a.get('user', resp['data']['id'])}"))
    for name, q in a.get("quotas", {}).items():
        allowed = q.get("user", {}).get("allowed") or q.get("allowed")
        used = q.get("user", {}).get("used") or q.get("used")
        if allowed is not None:
            kv(name.replace("_", " "), f"{used}/{allowed}")


